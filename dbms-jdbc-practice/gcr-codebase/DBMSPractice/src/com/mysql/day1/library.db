insert into borrow_records(student_id, book_id, borrow_date)
    -> values (101, 1, CURDATE());
    
select * from borrow_records;
+-----------+------------+---------+-------------+-------------+------+
| borrow_id | student_id | book_id | borrow_date | return_date | fine |
+-----------+------------+---------+-------------+-------------+------+
|         1 |        101 |       1 | 2026-02-06  | NULL        | NULL |
+-----------+------------+---------+-------------+-------------+------+

update books
    -> set available_copies = available_copies - 1
    -> where book_id = 1;

select * from books;
+---------+-----------------+---------------+-------------+------------------+
| book_id | title           | author        | category    | available_copies |
+---------+-----------------+---------------+-------------+------------------+
|       1 | Java Basics     | James Gosling | Programming |                4 |
|       2 | Database System | Korth         | Database    |                3 |
|       3 | Python Guide    | Mark Lutz     | Programming |                4 |
+---------+-----------------+---------------+-------------+------------------+

update borrow_records
    -> set return_date = CURDATE()
    -> where borrow_id = 1;
 select * from borrow_records;
+-----------+------------+---------+-------------+-------------+------+
| borrow_id | student_id | book_id | borrow_date | return_date | fine |
+-----------+------------+---------+-------------+-------------+------+
|         1 |        101 |       1 | 2026-02-06  | 2026-02-07  | NULL |
+-----------+------------+---------+-------------+-------------+------+

update books
    -> set available_copies = available_copies + 1
    -> where book_id = 1;
    
select * from books;
+---------+-----------------+---------------+-------------+------------------+
| book_id | title           | author        | category    | available_copies |
+---------+-----------------+---------------+-------------+------------------+
|       1 | Java Basics     | James Gosling | Programming |                6 |
|       2 | Database System | Korth         | Database    |                4 |
|       3 | Python Guide    | Mark Lutz     | Programming |                5 |
+---------+-----------------+---------------+-------------+------------------+

update borrow_records
    -> SET fine =
    ->     CASE
    ->         WHEN DATEDIFF(return_date, borrow_date) > 7
    ->         THEN (DATEDIFF(return_date, borrow_date) - 7) * 5
    ->         ELSE 0
    ->     END;
    
SELECT s.student_name, b.title, br.borrow_date, br.return_date, br.fine
    -> FROM borrow_records br
    -> JOIN students s ON br.student_id = s.student_id
    -> JOIN books b ON br.book_id = b.book_id;
+--------------+-------------+-------------+-------------+------+
| student_name | title       | borrow_date | return_date | fine |
+--------------+-------------+-------------+-------------+------+
| Arya         | Java Basics | 2026-02-06  | 2026-02-07  | 0.00 |
+--------------+-------------+-------------+-------------+------+

