/*
Exercise 2: Transaction Management
Implement a banking system with:
• Transfer money between accounts (use transactions)
• Check balance
• Transaction history
*/

create database Transaction_Management;
use Transaction_Management;

create table accounts
    -> ( id INT PRIMARY KEY,
    ->   name VARCHAR(20),
    ->   balance DECIMAL(10,2));

insert into accounts values
    -> (1,'Arya',50000),
    -> (2,'Bhumika',40000);

select * from accounts;
+----+---------+----------+
| id | name    | balance  |
+----+---------+----------+
|  1 | Arya    | 50000.00 |
|  2 | Bhumika | 40000.00 |
+----+---------+----------+

create table transactions(
    -> transaction_id INT AUTO_INCREMENT PRIMARY KEY,
    -> from_account INT,
    -> to_account INT,
    -> amount DECIMAL(10,2),
    -> transaction_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP);
    
select balance from accounts where id = 1;
+----------+
| balance  |
+----------+
| 50000.00 |
+----------+

start transaction;

-- Deduct from sender
update accounts
	-> set balance = balance - 1000
	-> where id = 1;

-- Add to receiver
update accounts
	-> set balance = balance + 1000
	-> where id = 2;

-- Insert transaction history
insert into transactions (from_account, to_account, amount)
-> values (1, 2, 1000);

commit;

select * from accounts;
+----+---------+----------+
| id | name    | balance  |
+----+---------+----------+
|  1 | Arya    | 49000.00 |
|  2 | Bhumika | 41000.00 |
+----+---------+----------+

start transaction;

update accounts
    -> set balance = balance - 1000
    -> where id = 1;
    
rollback;

-- Transaction History
select * from transactions;
+----------------+--------------+------------+---------+---------------------+
| transaction_id | from_account | to_account | amount  | transaction_date    |
+----------------+--------------+------------+---------+---------------------+
|              1 |            1 |          2 | 1000.00 | 2026-02-06 16:51:22 |
+----------------+--------------+------------+---------+---------------------+

SELECT * FROM accounts;
+----+---------+----------+
| id | name    | balance  |
+----+---------+----------+
|  1 | Arya    | 49000.00 |
|  2 | Bhumika | 41000.00 |
+----+---------+----------+