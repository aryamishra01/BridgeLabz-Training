mysql> create database hospitalmanagement;

mysql> use hospitalmanagement;
Database changed

mysql> create table patients
    -> ( patient_id int auto_increment primary key,
    -> name varchar(50),
    -> dob date,
    -> phone varchar(15) unique,
    -> address varchar(50),
    -> blood_group varchar(20),
    -> email varchar(50));
Query OK

mysql> insert into patients(name,dob,phone,address,blood_group,email)
    -> values('Arya Mishra','2004-09-24','8838109562','Jabalpur','O+','aryaamishra0001@gmail.com'),
    -> ('Bhumika Shrivas','2004-03-15','8104023989','Bhopal','A+','bhumikashrivas12@gmail.com');
Query OK

mysql> select * from patients;
